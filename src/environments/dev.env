PORT=3080

# ENVIRONMENT_PROFILE=dev
# Uncomment to enable desktop mode
ENVIRONMENT_PROFILE=desktop
LAB_MANAGER_VERSION=2.14.0
LAB_MANAGER_API_KEY=1234
LAB_MANAGER_STANDALONE_FRONT_VERSION=latest

# Logging
LOG_LEVEL=info
LOG_PATH=logs/lab-manager

ADDITIONAL_DOMAINS=[]

# only used to start the standalone front for desktop env
DESKTOP_COMMUNITY_API_URL=https://api.constellab.community
DESKTOP_COMMUNITY_FRONT_URL=https://constellab.community/

# The number of app additional processes(for env app) supported by the server
APP_NB_COUNT=6

# disable auto start of the lab when the lab-manager starts
AUTO_START_LAB=false

# disable auto start of the sub-composes when the lab-manager starts
AUTO_START_SUB_COMPOSES=false

# disable auto start of the standalone front when the lab-manager starts
AUTO_START_STANDALONE_FRONT=false