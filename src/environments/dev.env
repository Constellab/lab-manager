PORT=3080

ENVIRONMENT_PROFILE=dev
LAB_MANAGER_VERSION=1.20.0
LAB_MANAGER_API_KEY=123456
LAB_MANAGER_STANDALONE_FRONT_VERSION=latest

# Logging
LOG_LEVEL=info
LOG_PATH=logs/lab-manager

ADDITIONAL_DOMAINS=[]

# only used to start the standalone front for desktop env
DESKTOP_COMMUNITY_API_URL=https://api.constellab.community
DESKTOP_COMMUNITY_FRONT_URL=https://constellab.community/

# The number of app additional processes(for env app) supported by the server
APP_NB_COUNT=6