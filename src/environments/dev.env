PORT=3080

ENVIRONMENT_PROFILE=dev
LAB_MANAGER_VERSION=1.12.0
LAB_MANAGER_API_KEY=123456
LAB_MANAGER_STANDALONE_FRONT_VERSION=1.0.0

VOLUME_PATH=/app/conf

# Logging
LOG_LEVEL=info
LOG_PATH=logs/lab-manager

ADDITIONAL_DOMAINS=[]

LAB_NAME=MyLab
LAB_ID=1

# only used to start the standalone front for desktop env
COMMUNITY_API_URL=https://api.constellab.community
COMMUNITY_FRONT_URL=https://constellab.community/